{
  "rootDir": "../..",
  "files": [
    "roku-screensaver/manifest",
    "roku-screensaver/source/**/*.brs",
    "roku/source/utils.brs",
    "roku/source/constants.brs",
    "roku/source/gfx_cache.brs",
