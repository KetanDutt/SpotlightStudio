# Spotlight Studio mobile — optional configuration.
#
# Copy to `.env.local` (dev) or set these in the EAS build profile (release).  Every value
# ends up in the app bundle, so never put secrets here.  See ../docs/MOBILE.md.

# Full URL of a catalog JSON file.  Default: this repository's data/wallpapers.json on GitHub.
# EXPO_PUBLIC_CATALOG_URL=https://example.com/api/catalog

# Base URL that the `images/...` paths of the catalog are resolved against.
# Default: https://github.com/KetanDutt/SpotlightStudio/blob/main
# EXPO_PUBLIC_IMAGE_BASE=http://192.168.0.9:8765

# Base URL of a Spotlight Studio server (must be reachable from the phone).
# EXPO_PUBLIC_API_URL=http://192.168.0.9:8765
