# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Virtual environments ─────────────────────────────────────────────────
venv/
env/
.venv/

# ── Node tooling (the JS unit tests need no dependencies; keep accidental installs out)
node_modules/

# ── Local configuration & secrets ────────────────────────────────────────
.env
.env.local

# ── Runtime state ────────────────────────────────────────────────────────
# The database, the catalog JSON and the images ARE tracked in git.
# SQLite's transient side files are NOT: committing a stale -wal onto a newer
# database can corrupt it.
data/*.db-wal
data/*.db-shm
data/*.db-journal
*.db.lock
data/*.tmp
*.log
*.log.*
*.part

# ── IDEs & operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.~lock.*
*.tmp

# ── Packaging ────────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# Generated test reports
coverage/
playwright-report/
test-results/

# ── Mobile build artifacts ────────────────────────────────────────────────
.gradle/
android/.gradle/
mobile/**/.gradle/
*.apk
*.aab

# ── Roku build artifacts ─────────────────────────────────────────────
# dist/ holds the sideload-ready .zip packages produced by
# scripts/package_roku.py; they are reproducible from source and must never be
# committed (they would also blow past GitHub's per-repo limits).
dist/
scripts/roku/node_modules/
