title=Spotlight Studio
subtitle=4K Windows Spotlight & Peapix wallpapers for your TV

mm_icon_focus_fhd=pkg:/images/icon_fhd.png
mm_icon_focus_hd=pkg:/images/icon_hd.png
splash_screen_fhd=pkg:/images/splash_fhd.png
splash_screen_hd=pkg:/images/splash_hd.png
splash_color=#08090E
splash_min_time=500

major_version=2
minor_version=8
build_version=1
build_date=2026-10-22

# The channel renders into a fixed 1920x1080 canvas and lets the OS scale it
# down on 720p panels (see "Specifying display resolution" in the Roku docs).
ui_resolutions=fhd,hd

# Required for Direct to Play: ECP /launch and /input deep links are delivered
# while the channel is already running (certification requirement 5.2).
supports_input_launch=1

# Deliberately ABSENT: screensaver_title and screensaver_private.
#   * Certification 4.5 prohibits apps from overriding the system screensaver.
#   * Roku's screensaver policy states that a non-screensaver app that provides
#     screensaver_title "will be blocked" from publishing.
# The Ambient Collection lives inside the channel instead, and a standalone
# screensaver app can be built from the same source with:
#   python3 scripts/package_roku.py --variant screensaver
# See docs/roku/CERTIFICATION.md and roku-screensaver/README.md.
