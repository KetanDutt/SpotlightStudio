# Spotlight Studio — Environment Configuration
# Copy this file to .env and customize as needed.
# The defaults below are the recommended settings for most users.

# ── Server ──────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8765

# ── Paths (relative to project root) ────────────────────────────────
IMAGES_DIR=images
DB_PATH=data/wallpapers.db
LOG_PATH=data/downloader.log

# ── Concurrency & Multithreading ─────────────────────────────────────
# Simultaneous image downloads (asyncio tasks).
# Increase to 64 on fast connections (100+ Mbps).
CONCURRENT_DOWNLOADS=32

# Gallery pages scraped in parallel (feeds download queue).
CONCURRENT_SCRAPERS=4

# Max total open TCP connections in the aiohttp session pool.
MAX_CONNECTIONS=128

# Max connections to a single hostname.
MAX_CONNECTIONS_PER_HOST=48

# Worker threads for CPU-intensive tasks (Pillow decode, dHash, thumbnails).
# 0 = Python default: min(32, cpu_count + 4).
CPU_THREADS=0

# ── Reliability & Delays ─────────────────────────────────────────────
# Main engine loop tick delay in seconds.
REQUEST_DELAY_SECONDS=0.1

# Max download retry attempts per image before skipping.
MAX_RETRIES=3

# HTTP request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=30

# ── Source Site Page Counts ──────────────────────────────────────────
# Total gallery pages to seed into the scrape queue.
# These are auto-seeded only if the queue is empty.
PEAPIX_TOTAL_PAGES=30
WIN10_TOTAL_PAGES=1319