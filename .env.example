# Windows Spotlight Downloader — Environment Configuration
# Copy this file to .env and adjust values as needed.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8765

# ── Paths (relative to project root) ─────────────────────────────────────────
IMAGES_DIR=images
DB_PATH=data/wallpapers.db
STATE_PATH=data/state.json
LOG_PATH=data/downloader.log

# ── Concurrency & Multithreading (High-Throughput Settings) ───────────────────
# Number of simultaneous image downloads (asyncio tasks)
CONCURRENT_DOWNLOADS=32

# Number of gallery pages scraped in parallel (feeds download queue)
CONCURRENT_SCRAPERS=4

# Max total open TCP connections in the aiohttp session connection pool
MAX_CONNECTIONS=128

# Max connections to a single hostname (e.g., img.peapix.com, windows10spotlight.com)
MAX_CONNECTIONS_PER_HOST=48

# Number of worker threads for CPU-intensive tasks (Pillow decode, dHash, thumbnails).
# Set to 0 to use Python default: min(32, (os.cpu_count() or 1) + 4)
CPU_THREADS=0

# ── Reliability & Delays ──────────────────────────────────────────────────────
# Main engine loop tick delay (in seconds)
REQUEST_DELAY_SECONDS=0.1
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30

# ── Source Site Total Pages (Auto-seeded into scrape queue) ───────────────────
PEAPIX_TOTAL_PAGES=30
WIN10_TOTAL_PAGES=1319
