# Spotlight Studio – configuration
# Copy this file to ".env" (the Windows launchers do it for you) and change what you need.
# Every setting is optional; the values below are the defaults.  Full reference:
# docs/CONFIGURATION.md.  Invalid values fall back to the default and log a warning.

# ── Server ───────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8765
# Host headers the API answers to (comma separated, "*.lan" wildcards allowed).  Empty =
# loopback names only – or any host when HOST is not a loopback address.
# ALLOWED_HOSTS=
# Extra browser origins allowed to call the API (CORS).  Empty = same-origin only.
# CORS_ORIGINS=

# ── Paths (relative to the project folder, or absolute) ───────────────────
IMAGES_DIR=images
DB_PATH=data/wallpapers.db
LOG_PATH=data/downloader.log
# Static catalog used by the GitHub-Pages showcase.  Default: next to the database.
# CATALOG_PATH=data/wallpapers.json

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Rotate the log file at this size (bytes) and keep this many old files.
LOG_MAX_BYTES=5242880
LOG_BACKUPS=3

# ── Concurrency ──────────────────────────────────────────────────────────
# Simultaneous image downloads.  Raise to 64 on very fast connections.
CONCURRENT_DOWNLOADS=32
# Gallery pages scraped in parallel.
CONCURRENT_SCRAPERS=4
# Open TCP connections in total / per host.
MAX_CONNECTIONS=128
MAX_CONNECTIONS_PER_HOST=48
# Threads for Pillow work (decode, hash, thumbnails).  0 = automatic.
CPU_THREADS=0

# ── Reliability & politeness ─────────────────────────────────────────────
# Pause (seconds) after every scraped gallery page, per scraper.
REQUEST_DELAY_SECONDS=0.1
# Attempts per page / image before giving up (failed items go to the back of the queue).
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30
# Verify TLS certificates.  Only disable behind a broken corporate proxy.
VERIFY_SSL=true
# Safety limits for downloaded images.
MAX_IMAGE_BYTES=41943040
MIN_IMAGE_WIDTH=320

# ── Source sites ─────────────────────────────────────────────────────────
# Page counts are hints: with AUTO_DETECT_PAGES the crawler discovers the real number
# (the sites grow every day).
PEAPIX_TOTAL_PAGES=30
WIN10_TOTAL_PAGES=1320
AUTO_DETECT_PAGES=true
# "Quick update" scans this many of the newest pages per site.
QUICK_UPDATE_PAGES=3
# Base URLs (change only for mirrors / testing).
PEAPIX_BASE_URL=https://peapix.com
PEAPIX_IMAGE_BASE_URL=https://img.peapix.com
WIN10_BASE_URL=https://windows10spotlight.com
# USER_AGENT=
